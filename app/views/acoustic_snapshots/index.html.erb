<style>
    body { background-color: #0f172a; color: #f8fafc; font-family: -apple-system, sans-serif; padding: 30px; margin: 0; }
    .wrapper { max-width: 900px; margin: 0 auto; }

    .portfolio-banner { background: #0369a1; border-radius: 8px; padding: 15px 20px; margin-bottom: 25px; border-left: 5px solid #38bdf8; font-size: 14px; line-height: 1.5; }
    .portfolio-banner code { background: #0c4a6e; padding: 2px 6px; border-radius: 4px; font-family: monospace; color: #e0f2fe; }

    .control-panel { background: #1e293b; border-radius: 12px; padding: 25px; margin-bottom: 20px; border: 1px solid #334155; }
    .panel-columns { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; }

    .interaction-zone { display: flex; flex-direction: column; gap: 12px; max-width: 450px; }
    .action-group { display: flex; gap: 10px; align-items: center; }

    .upload-btn { background: #475569; color: #f8fafc; padding: 10px 16px; border-radius: 6px; font-weight: 600; cursor: pointer; border: 1px solid #64748b; font-size: 13px; text-align: center; }
    .upload-btn:hover { background: #64748b; }
    input[type="file"] { display: none; }

    .sim-btn { color: #0f172a; padding: 10px 16px; border-radius: 6px; font-weight: bold; cursor: pointer; border: none; font-size: 13px; display: inline-flex; align-items: center; gap: 6px; }
    .sim-success { background: #10b981; }
    .sim-success:hover { background: #34d399; }
    .sim-failure { background: #f43f5e; }
    .sim-failure:hover { background: #fb7185; }

    .status-badge { padding: 6px 12px; border-radius: 20px; font-size: 13px; font-weight: bold; text-transform: uppercase; background: #334155; display: inline-block; }
    .healthy { background: #065f46; color: #34d399; }
    .anomaly { background: #991b1b; color: #f87171; }
    .chart-container { background: #1e293b; border-radius: 12px; padding: 20px; border: 1px solid #334155; }
    .axis-label { fill: #94a3b8; font-size: 11px; font-weight: 600; }
    .domain, .tick line { stroke: #475569; }
    .tick text { fill: #94a3b8; }
</style>

<div class="wrapper">
    <div class="portfolio-banner">
        <strong>⚙️ Predictive Maintenance Architecture Framework:</strong> This pipeline maps high-frequency raw vibrational telemetry directly inside RAM memory layout maps. The server processes binary byte structures stream-pipes via a multi-slice linear array calculation, routing safe states or alerting mechanical fatigue models instantly.
    </div>

    <h1>🌲 Full-Stack In-Memory Audio Processor</h1>
    <p style="color: #94a3b8; margin-top: -10px; margin-bottom: 25px;">Ingest raw structural telemetry metrics directly to trigger the remote Hetzner Rails API pipe.</p>

    <div class="control-panel">
        <div class="panel-columns">
            <div class="interaction-zone">
                <span style="font-size: 12px; font-weight: bold; text-transform: uppercase; color: #64748b; tracking-wider;">1-Click Pipeline Simulation</span>
                <div class="action-group">
                    <button class="sim-btn sim-success" data-preset="healthy">🟢 Run Safe Log</button>
                    <button class="sim-btn sim-failure" data-preset="anomaly">🔴 Trigger Failure</button>
                </div>

                <span style="font-size: 12px; font-weight: bold; text-transform: uppercase; color: #64748b; tracking-wider; margin-top: 8px;">Or Ingest Native Binary Log</span>
                <label class="upload-btn">
                    📁 Choose Local .WAV telemetry file...
                    <input type="file" id="server-upload" accept="audio/*">
                </label>
            </div>

            <div style="text-align: right; min-width: 250px;">
                <span style="font-size: 12px; font-weight: bold; text-transform: uppercase; color: #64748b; tracking-wider; display: block; margin-bottom: 8px;">Telemetry Diagnostics</span>
                <div>Server Status: <span id="health-badge" class="status-badge">Idle</span></div>
                <div id="flagged-hz" style="font-size: 13px; margin-top: 12px; color: #e2e8f0; font-weight: 500;">Select an action vector to initialize...</div>
            </div>
        </div>
    </div>

    <div class="chart-container">
        <svg id="server-spectrum" width="840" height="400"></svg>
    </div>
</div>

<script type="module">
    import * as d3 from "d3";

    // 1. Initialize D3 Canvas Dimensions
    const svg = d3.select("#server-spectrum");
    const margin = {top: 20, right: 20, bottom: 50, left: 60};
    const width = +svg.attr("width") - margin.left - margin.right;
    const height = +svg.attr("height") - margin.top - margin.bottom;
    const g = svg.append("g").attr("transform", `translate(${margin.left},${margin.top})`);

    const xScale = d3.scaleLog().domain([1, 100]).range([0, width]);
    const yScale = d3.scaleLinear().domain([0, 255]).range([height, 0]);

    g.append("g").attr("transform", `translate(0,${height})`).call(d3.axisBottom(xScale).ticks(10, ",d"));
    g.append("g").call(d3.axisLeft(yScale).ticks(5));

    g.append("text").attr("class", "axis-label").attr("x", width/2).attr("y", height + 40).style("text-anchor", "middle").text("Frequency (Hz) - Server-Analyzed Log Scale");
    g.append("text").attr("class", "axis-label").attr("transform", "rotate(-90)").attr("y", -45).attr("x", -height/2).style("text-anchor", "middle").text("Vibration Magnitude (dB)");

    async function transmitTelemetry(fileObject, explicitSimulationType = null) {
        document.getElementById('health-badge').innerText = "Processing...";
        document.getElementById('health-badge').className = "status-badge";

        const formData = new FormData();
        if (fileObject) {
            formData.append('audio_file', fileObject);
        }
        if (explicitSimulationType) {
            formData.append('simulation_mode', explicitSimulationType);
        }
        formData.append('turbine_serial', 'WT-RENEW-01');

        try {
            const endpointUrl = '/api/v1/diagnostics/upload_audio';
            const response = await fetch(endpointUrl, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                }
            });

            const result = await response.json();
            const serverMagnitudes = result.frequency_magnitudes.map((val, index) => {
                return { hz: index, magnitude: val };
            }).filter(d => d.hz > 0);

            const badge = document.getElementById('health-badge');
            if (result.turbine_health === 'healthy') {
                badge.innerText = "Healthy";
                badge.className = "status-badge healthy";
                document.getElementById('flagged-hz').innerText = "✅ Overtones within structural fundamental limits.";
            } else {
                badge.innerText = "Anomaly Detected";
                badge.className = "status-badge anomaly";
                document.getElementById('flagged-hz').innerText = `⚠️ Critical bearing fault isolated at: ${result.flagged_frequency_hz}Hz`;
            }

            updateChart(serverMagnitudes, result.flagged_frequency_hz);

        } catch (error) {
            console.error("Pipeline network breakdown:", error);
            document.getElementById('health-badge').innerText = "Network Error";
        }
    }

    document.getElementById('server-upload').addEventListener('change', function(e) {
        if (e.target.files && e.target.files[0]) {
            transmitTelemetry(e.target.files[0], null);
        }
    });

    document.querySelectorAll('.sim-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const mode = this.getAttribute('data-preset');
            transmitTelemetry(null, mode);
        });
    });

    function updateChart(data, anomalyHz) {
        const bars = g.selectAll(".bar").data(data);
        bars.exit().remove();

        bars.enter().append("rect")
            .attr("class", "bar")
            .merge(bars)
            .attr("x", d => xScale(d.hz))
            .attr("y", d => yScale(d.magnitude))
            .attr("width", d => {
                const nextHz = Math.min(100, d.hz + 1);
                return Math.max(1.5, xScale(nextHz) - xScale(d.hz));
            })
            .attr("height", d => height - yScale(d.magnitude))
            .attr("fill", d => {
                if (d.hz === anomalyHz) return "#f43f5e"; // Red structural failure line
                if (d.magnitude >= 160) return "#eab308"; // Amber near thresholds warning hums
                return "#38bdf8"; // Balanced telemetry tracking signals
            });
    }
</script>
